{
  "name": "resultview-server",
  "version": "1.0.0",
  "description": "GPA Calculator API - Proxy for University of Ruhuna FOSMIS results",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --forceExit",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch --forceExit",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage --forceExit"
  },
  "keywords": [
    "gpa",
    "university",
    "results",
    "fosmis"
  ],
  "author": "Isuru Shanaka",
  "license": "ISC",
  "dependencies": {
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "fetch-cookie": "^3.1.0",
    "node-fetch": "^3.3.2",
    "tough-cookie": "^6.0.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "jest": "^30.5.2",
    "nodemon": "^3.1.4",
    "supertest": "^7.3.1"
  }
}
